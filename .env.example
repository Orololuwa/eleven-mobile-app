# FastAPI backend. iOS simulator: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Physical device: http://<your-lan-ip>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Auth0 native application (must match FastAPI AUTH0_DOMAIN / AUTH0_AUDIENCE)
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-auth0-native-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# After changing Auth0 domain, rebuild the native client:
#   npx expo prebuild --clean && npx expo run:ios
#
# Auth0 callback / logout URLs (scheme eleven, bundle com.eleven.app):
#   eleven://YOUR_DOMAIN/ios/com.eleven.app/callback
#   eleven://YOUR_DOMAIN/android/com.eleven.app/callback
